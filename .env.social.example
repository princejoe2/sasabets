# Sabula 256 — Social Media API Keys
# Copy this to .env.social and fill in real values
# Run: node scripts/social-post.mjs "Your message" --link https://sabula256.com

# ── Twitter/X ─────────────────────────────────────────────────
# Get from: developer.twitter.com → Project → Keys and Tokens
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_TOKEN_SECRET=

# ── Facebook Page ─────────────────────────────────────────────
# PAGE_ID: your numeric page ID (visible in Page settings)
# PAGE_TOKEN: generate at developers.facebook.com → Graph API Explorer
#   → select your app → select your page → generate Page Access Token
#   (request pages_manage_posts permission)
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_TOKEN=

# ── Instagram Business ────────────────────────────────────────
# Must be an Instagram Business account linked to your Facebook Page
# USER_ID: your Instagram Business Account ID (from Graph API)
# PAGE_TOKEN: same long-lived token as Facebook above
# DEFAULT_IMAGE_URL: a hosted image to attach to every IG post (required by API)
INSTAGRAM_USER_ID=
INSTAGRAM_PAGE_TOKEN=
INSTAGRAM_DEFAULT_IMAGE_URL=https://sabula256.com/og-image.png

# ── Telegram Channel ──────────────────────────────────────────
# Create a bot at t.me/BotFather → /newbot → copy token
# Add the bot as admin to your channel
# CHANNEL_ID: @sabula256 (or numeric -100xxxxxxxx)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=@sabula256
